# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Python Backend
backend/.env
# Belt and braces: only backend/.venv/ should ever exist, but ignore both
# names so a stray `venv` created by habit never gets committed either.
backend/.venv/
backend/venv/
**/__pycache__/
**/*.db
backend/uploads/*
!backend/uploads/.gitkeep
backend/uvicorn*.log
**/.pytest_cache/
local.properties
